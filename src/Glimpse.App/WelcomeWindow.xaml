<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Glimpse.App.WelcomeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Welcome to Glimpse">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.Resources>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
                <Setter Property="Padding" Value="16,12" />
            </Style>
            <Style x:Key="Step" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="2,22,0,2" />
            </Style>
            <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBar" />

        <ScrollViewer Grid.Row="1">
            <StackPanel Padding="40,0,40,24" Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <Image x:Name="Logo" Width="52" Height="52" VerticalAlignment="Center" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Welcome to Glimpse" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock Text="Find any screenshot or image by the text in it, or by what it looks like."
                                   Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>

                <!-- 1. Folders -->
                <TextBlock Text="1   Choose folders" Style="{StaticResource Step}" />
                <TextBlock Style="{StaticResource Hint}" Margin="2,0,0,6"
                           Text="Glimpse reads the text in images in these folders, then keeps watching them for new ones. Your files are never changed or uploaded." />
                <StackPanel x:Name="FolderList" Spacing="4" />
                <HyperlinkButton Click="OnAddFolder" Padding="2,4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="12" />
                        <TextBlock Text="Add another folder" />
                    </StackPanel>
                </HyperlinkButton>

                <!-- 2. Visual search -->
                <TextBlock Text="2   Visual search (optional)" Style="{StaticResource Step}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="2">
                        <CheckBox x:Name="DownloadModel" Content="Download the visual search model now" />
                        <TextBlock x:Name="ModelHint" Style="{StaticResource Hint}" Margin="28,0,0,0" />
                    </StackPanel>
                </Border>

                <!-- 3. Shortcut -->
                <TextBlock Text="3   Your shortcut" Style="{StaticResource Step}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="8">
                        <StackPanel x:Name="KeyCaps" Orientation="Horizontal" Spacing="6" />
                        <TextBlock x:Name="ShortcutHint" Style="{StaticResource Hint}" />
                    </StackPanel>
                </Border>

                <CheckBox x:Name="AutoStartBox" Content="Start Glimpse when I sign in (it waits quietly in the tray)" IsChecked="True" Margin="2,14,0,0" />
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Padding="40,14" ColumnSpacing="16"
              Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE72E;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="Everything stays on this PC." Style="{StaticResource Hint}" VerticalAlignment="Center" />
            </StackPanel>
            <Button x:Name="StartButton" Grid.Column="1" Content="Start" Click="OnStart"
                    Style="{StaticResource AccentButtonStyle}" MinWidth="120" />
        </Grid>
    </Grid>
</Window>
