<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Glimpse.App.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Glimpse Settings">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.Resources>
            <!-- Windows 11 Settings-style card: icon · title/description · control -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="MinHeight" Value="68" />
            </Style>
            <Style x:Key="CardIcon" TargetType="FontIcon">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="Margin" Value="4,0,20,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="2,28,0,8" />
            </Style>
            <Style x:Key="CardDescription" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBar" Padding="16,0,140,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image x:Name="TitleIcon" Width="16" Height="16" />
                <TextBlock Text="Glimpse Settings" Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel MaxWidth="980" Padding="40,4,40,40" Spacing="4">
                <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" Margin="2,0,0,4" />

                <!-- ============================== General ============================== -->
                <TextBlock Text="General" Style="{StaticResource SectionHeader}" />

                <Border Style="{StaticResource Card}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE765;" Style="{StaticResource CardIcon}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Keyboard shortcut" />
                            <TextBlock Text="Opens Glimpse from anywhere. Checked against shortcuts other apps already use."
                                       Style="{StaticResource CardDescription}" />
                            <TextBlock x:Name="HotkeyStatus" Style="{StaticResource CaptionTextBlockStyle}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <ToggleButton x:Name="ModWin" Content="Win" Click="OnHotkeyChanged" MinWidth="52" />
                            <ToggleButton x:Name="ModCtrl" Content="Ctrl" Click="OnHotkeyChanged" MinWidth="52" />
                            <ToggleButton x:Name="ModAlt" Content="Alt" Click="OnHotkeyChanged" MinWidth="52" />
                            <ToggleButton x:Name="ModShift" Content="Shift" Click="OnHotkeyChanged" MinWidth="52" />
                            <TextBlock Text="+" VerticalAlignment="Center" Margin="4,0" />
                            <ComboBox x:Name="HotkeyKey" MinWidth="96" SelectionChanged="OnHotkeyChanged" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE7E8;" Style="{StaticResource CardIcon}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Start with Windows" />
                            <TextBlock x:Name="AutoStartDescription" Text="Starts in the tray when you sign in, ready for the shortcut."
                                       Style="{StaticResource CardDescription}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="AutoStartSwitch" Grid.Column="2" Toggled="OnAutoStartToggled"
                                      OnContent="On" OffContent="Off" MinWidth="0" />
                    </Grid>
                </Border>

                <!-- ============================== Folders ============================== -->
                <TextBlock Text="Folders" Style="{StaticResource SectionHeader}" />
                <TextBlock Style="{StaticResource CardDescription}" Margin="2,-4,0,8"
                           Text="Images in these folders are indexed and watched for new ones. The name is what in:name searches; renaming or removing a folder takes its images out of the index." />

                <StackPanel x:Name="FolderList" Spacing="4" />

                <Border Style="{StaticResource Card}" MinHeight="0">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="FolderSummary" VerticalAlignment="Center" Style="{StaticResource CardDescription}" />
                        <Button Grid.Column="1" Click="OnAddFolder" Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontSize="14" />
                                <TextBlock Text="Add folder" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- ============================== Visual search ============================== -->
                <TextBlock Text="Visual search" Style="{StaticResource SectionHeader}" />

                <Border Style="{StaticResource Card}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE7B3;" Style="{StaticResource CardIcon}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Search by what images look like" />
                            <TextBlock Text="Finds “network diagram” or “bar chart” even when the image contains no such words. Runs entirely on this PC."
                                       Style="{StaticResource CardDescription}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="VisualSwitch" Grid.Column="2" Toggled="OnVisualToggled"
                                      OnContent="On" OffContent="Off" MinWidth="0" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}">
                    <Grid ColumnSpacing="12" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <FontIcon Glyph="&#xE896;" Style="{StaticResource CardIcon}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="ModelTitle" Text="Model" />
                            <TextBlock x:Name="ModelStatus" Style="{StaticResource CardDescription}" />
                            <HyperlinkButton x:Name="ModelSource" Padding="0" FontSize="12" Margin="0,2,0,0" />
                        </StackPanel>
                        <Button x:Name="ModelButton" Grid.Column="2" Click="OnModelButton" VerticalAlignment="Center" MinWidth="120" />
                        <StackPanel x:Name="ModelProgressPanel" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Visibility="Collapsed" Spacing="4">
                            <ProgressBar x:Name="ModelProgress" Maximum="1" />
                            <TextBlock x:Name="ModelProgressText" Style="{StaticResource CardDescription}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE950;" Style="{StaticResource CardIcon}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Use the graphics card" />
                            <TextBlock Text="Much faster visual indexing through DirectX 12. Falls back to the processor when no suitable GPU is found."
                                       Style="{StaticResource CardDescription}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="GpuSwitch" Grid.Column="2" Toggled="OnGpuToggled"
                                      OnContent="On" OffContent="Off" MinWidth="0" />
                    </Grid>
                </Border>

                <!-- ============================== Indexing ============================== -->
                <TextBlock Text="Indexing" Style="{StaticResource SectionHeader}" />

                <Border Style="{StaticResource Card}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE753;" Style="{StaticResource CardIcon}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Include OneDrive online-only files" />
                            <TextBlock Text="Downloads cloud-only images so they can be read. They then take space on this PC until OneDrive frees it."
                                       Style="{StaticResource CardDescription}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="CloudSwitch" Grid.Column="2" Toggled="OnCloudToggled"
                                      OnContent="On" OffContent="Off" MinWidth="0" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE9D9;" Style="{StaticResource CardIcon}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Parallel workers" />
                            <TextBlock x:Name="WorkersDescription" Style="{StaticResource CardDescription}" />
                        </StackPanel>
                        <NumberBox x:Name="WorkersBox" Grid.Column="2" Minimum="1" SpinButtonPlacementMode="Inline"
                                   VerticalAlignment="Center" MinWidth="120" ValueChanged="OnWorkersChanged" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8F1;" Style="{StaticResource CardIcon}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Index" />
                            <TextBlock x:Name="IndexStatsText" Style="{StaticResource CardDescription}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Content="Re-index now" Click="OnReindex" />
                            <Button Content="Rebuild…" Click="OnRebuild" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE91B;" Style="{StaticResource CardIcon}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Thumbnail cache" />
                            <TextBlock x:Name="ThumbStats" Text="Measuring…" Style="{StaticResource CardDescription}" />
                        </StackPanel>
                        <Button x:Name="ClearThumbsButton" Grid.Column="2" Content="Clear" Click="OnClearThumbnails" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- ============================== About ============================== -->
                <TextBlock Text="About" Style="{StaticResource SectionHeader}" />

                <Border Style="{StaticResource Card}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Image x:Name="AboutIcon" Width="28" Height="28" Margin="0,0,16,0" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="AboutVersion" />
                            <TextBlock Text="Find any screenshot or image by the text in it or by what it looks like. Everything stays on this PC."
                                       Style="{StaticResource CardDescription}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Content="Open data folder" Click="OnOpenDataFolder" />
                            <Button Content="Open log" Click="OnOpenLog" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
