<Project Sdk="Microsoft.NET.Sdk">
  <!-- PowerToys Command Palette extension: an MSIX-packaged COM server the palette discovers through
       the com.microsoft.commandpalette app extension. Based on the template that ships inside
       Command Palette ("Create a new extension"), retargeted to .NET 9. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Glimpse.CmdPal</RootNamespace>
    <AssemblyName>Glimpse.CmdPal</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <TargetFramework>net9.0-windows10.0.26100.0</TargetFramework>
    <!-- The extension toolkit is compiled against this Windows SDK projection (template value). -->
    <WindowsSdkPackageVersion>10.0.26100.68-preview</WindowsSdkPackageVersion>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Platforms>x64;ARM64</Platforms>
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <PlatformTarget>$(Platform)</PlatformTarget>
    <RuntimeIdentifier Condition="'$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>

    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Self-contained so the package doesn't depend on a machine-wide .NET install. -->
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\*.png" CopyToOutputDirectory="PreserveNewest" />
    <Manifest Include="$(ApplicationManifest)" />
    <!-- Wire protocol shared with the Glimpse app (no reference to Glimpse.Core: keeps SQLite/ONNX out). -->
    <Compile Include="..\Glimpse.Core\Ipc\GlimpseIpc.cs" Link="Ipc\GlimpseIpc.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CommandPalette.Extensions" Version="0.9.260303001" />
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.2.0" />
    <PackageReference Include="Shmuelie.WinRTServer" Version="2.1.1" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.0.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.MSIX" Version="1.7.251221100">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <!-- Windows metadata (.winmd) for CsWinRT's projection of the extension interfaces. Normally read from
         an installed Windows SDK; taking it from NuGet means building needs only the .NET SDK. -->
    <PackageReference Include="Microsoft.Windows.SDK.Contracts" Version="10.0.26100.1742" ExcludeAssets="all" GeneratePathProperty="true" />
  </ItemGroup>

  <PropertyGroup>
    <CsWinRTWindowsMetadata>$(PkgMicrosoft_Windows_SDK_Contracts)\ref\netstandard2.0</CsWinRTWindowsMetadata>
  </PropertyGroup>

  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>
</Project>
